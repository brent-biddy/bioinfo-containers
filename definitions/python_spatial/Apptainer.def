Bootstrap: docker
From: mambaorg/micromamba:1.5.10-jammy-cuda-12.5.1

%files
    environment.yml /environment.yml

%post
    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        gdebi-core \
        git \
        procps \
        tini
    rm -rf /var/lib/apt/lists/*

    QUARTO_VERSION=1.6.42
    curl -fsSLo /tmp/quarto.deb \
        "https://github.com/quarto-dev/quarto-cli/releases/download/v${QUARTO_VERSION}/quarto-${QUARTO_VERSION}-linux-amd64.deb"
    gdebi -n /tmp/quarto.deb
    rm -f /tmp/quarto.deb

    test -f /environment.yml
    export CONDA_OVERRIDE_CUDA=12.9
    micromamba create -y -n python_spatial -f /environment.yml
    /opt/conda/envs/python_spatial/bin/python -m ipykernel install --sys-prefix --name python_spatial --display-name "Python (python_spatial)"
    micromamba clean --all --yes

    mkdir -p /tmp/matplotlib /tmp/numba-cache /tmp/.cache /tmp/cupy-cache

%environment
    export PATH=/opt/conda/envs/python_spatial/bin:/opt/conda/bin:$PATH
    export MPLCONFIGDIR=/tmp/matplotlib
    export NUMBA_CACHE_DIR=/tmp/numba-cache
    export XDG_CACHE_HOME=/tmp/.cache
    # cupy's JIT kernel cache defaults to ~/.cupy, which doesn't respect
    # XDG_CACHE_HOME and is read-only for root at build-%test time.
    export CUPY_CACHE_DIR=/tmp/cupy-cache
    export PYTHONUNBUFFERED=1

%runscript
    exec /usr/bin/tini -- "$@"

%test
    export PATH=/opt/conda/envs/python_spatial/bin:/opt/conda/bin:$PATH
    export CUPY_CACHE_DIR=/tmp/cupy-cache
    python - <<'PY'
import nbformat
import papermill
import yaml
import session_info
import spatialdata
import spatialdata_io
import spatialdata_plot
import scanpy
import squidpy
import rapids_singlecell
print("python runtime ok")
PY
