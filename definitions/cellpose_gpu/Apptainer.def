# Segmentation: the CPU image plus cellpose+torch.
#
# Bootstrapped from python_cpu, not python_gpu. python_gpu already carries RAPIDS/cuML/cuDF, and
# adding the CUDA pytorch/torchvision/cellpose overlay on top of that landed at 11.02 GB -- over
# GHCR's documented 10 GB per-layer limit, measured directly, not assumed. The same overlay on
# python_cpu landed at 6.59 GB. A segmentation workflow that also needs to cluster with
# rapids-singlecell in the same run is a real cost of this choice; a too-large-to-publish image
# is not an available alternative to weigh it against.
#
# The base tag is pinned deliberately: a cellpose_gpu image is only meaningful against a known
# analysis stack, and segmentation output has to be reproducible. Bump it when you mean to.
#
#   apptainer build cellpose_gpu.sif definitions/cellpose_gpu/Apptainer.def
Bootstrap: oras
From: ghcr.io/brent-biddy/python_cpu-sif:1.0.2

%files
    definitions/cellpose_gpu/environment.yml /cellpose.yml

%post
    test -f /cellpose.yml

    # Installed into the existing env rather than a new one, so there is a single interpreter
    # and `python` means the same thing here as in the base image.
    export CONDA_OVERRIDE_CUDA=12.9
    micromamba install -y -n python_cpu -f /cellpose.yml
    micromamba clean --all --yes

%environment
    # Inherited from python_cpu: PATH, JUPYTER_PATH, CONDA_PREFIX and the cache locations. The
    # env name does not change, so nothing here needs restating.
    export CELLPOSE_LOCAL_MODELS_PATH=/tmp/cellpose-models

%runscript
    exec /usr/bin/tini -- "$@"

%test
    export PATH=/opt/conda/envs/python_cpu/bin:/opt/conda/bin:$PATH

    python - <<'PY'
import cellpose, torch
import spatialdata
print("cellpose", cellpose.version)
print("torch cuda build:", torch.version.cuda)
PY
    echo "configures itself: ok"
